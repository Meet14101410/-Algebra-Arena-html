/* Algebra Arena Styling */
body {
  background: linear-gradient(to right, #4facfe, #00f2fe);
  font-family: Arial, sans-serif;
  text-align: center;
  color: #fff;
}

h1 {
  margin-top: 50px;
  font-size: 40px;
}

p {
  font-size: 20px;
}

input {
  padding: 10px;
  font-size: 16px;
  border: none;
  border-radius: 5px;
  margin: 10px;
}

button {
  padding: 10px 20px;
  font-size: 16px;
  background: #fff;
  color: #333;
  border: none;
  border-radius: 5px;
  cursor: pointer;
}

button:hover {
  background: #333;
  color: #fff;
}

#result {
  margin-top: 15px;
  font-size: 18px;
  font-weight: bold;
}
